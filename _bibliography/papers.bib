@inproceedings{vassef-etal-2025-soi,
  abbr={EMNLP 2025},
  title={{SOI} Matters: Analyzing Multi-Setting Training Dynamics in Pretrained Language Models via Subsets of Interest},
  author={Vassef*, Shayan and Dabiriaghdam*, Amirhossein and Bakhtiari*, Mohammadreza and Yaghoobzadeh, Yadollah},
  booktitle={Proceedings of the 5th Workshop on Multilingual Representation Learning (MRL 2025)},
  year={2025},
  status={peer-reviewed},
  note={* Equal contribution},
  co_located_with={EMNLP 2025},
  month={November},
  pages={322--335},
  publisher={Association for Computational Linguistics},
  doi={10.18653/v1/2025.mrl-main.21},
  html={https://aclanthology.org/2025.mrl-main.21/},
  pdf={https://aclanthology.org/2025.mrl-main.21.pdf},
  summary={Introduces Subsets of Interest to track example-level learning dynamics across multi-task, multilingual, and multi-source training and guide targeted fine-tuning.},
  abstract={This work investigates multi-task, multilingual, and multi-source learning in pretrained language models. It introduces Subsets of Interest, a six-category framework for tracking learning behaviours such as forgettable, unlearned, and always-correct examples. Experiments compare single-setting and multi-setting training through transition heatmaps and dataset cartography across English language tasks, sentiment datasets, and intent classification in French, English, and Persian. Multi-source learning improves out-of-distribution performance by up to 7 percent, while multi-task gains depend on task similarity. A two-stage fine-tuning method using SOI-based subset selection provides further improvements.}
}

