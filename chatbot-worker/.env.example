GROQ_API_KEY=
MODEL=openai/gpt-oss-20b
ALLOWED_ORIGINS=https://dabiriaghdam.github.io,http://localhost:4000,http://127.0.0.1:4000
ADMIN_USERNAME=
ADMIN_PASSWORD=
PUBLIC_SITE_URL=https://dabiriaghdam.github.io/

# Fallback providers, tried in this order when Groq is out of quota or unreachable.
# All optional: with the key absent the provider is skipped entirely.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# One Google key configures three chain entries. Google meters its free tier per model,
# so each of these carries its own daily allowance rather than sharing one.
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it
GEMINI_MODEL_31B=gemma-4-31b-it
GEMINI_FLASH_MODEL=gemini-3.1-flash-lite

# Emailed activity digest through the owner-controlled Google Apps Script relay in
# tools/google-apps-script-digest.gs. Off unless all three values below are set.
DIGEST_WEBHOOK_URL=
DIGEST_WEBHOOK_SECRET=
DIGEST_TO_EMAIL=
DIGEST_INTERVAL_DAYS=7
